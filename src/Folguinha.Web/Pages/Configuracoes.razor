@page "/configuracoes/{Secao}"
@inherits PaginaBase

<PageTitle>@Titulo · Folguinha</PageTitle>

<Cabecalho Titulo="@Titulo" Voltar="@Volta" />

@switch (Secao)
{
    case "empresa":
        <div class="cartao"><EditorEmpresa /></div>
        break;
    case "funcionamento":
        <EditorFuncionamento />
        break;
    case "turnos":
        <EditorFuncoesTurnos />
        break;
    case "demanda":
        <EditorDemanda />
        break;
    case "feriados":
        <EditorFeriados />
        break;
    default:
        <Vazio Titulo="Seção não encontrada"><a class="botao" href="mais">Voltar</a></Vazio>
        break;
}

@code {
    [Parameter] public string Secao { get; set; } = "";
    [SupplyParameterFromQuery(Name = "volta")] public string? VoltaPara { get; set; }

    /// Quem chegou por um atalho volta para onde estava, não para "Mais".
    string Volta => VoltaPara is { Length: > 0 } v && !v.Contains("//", StringComparison.Ordinal) ? v : "mais";

    string Titulo => Secao switch
    {
        "empresa" => "Empresa",
        "funcionamento" => "Horário de funcionamento",
        "turnos" => "Turnos e funções",
        "demanda" => "Quantas pessoas",
        "feriados" => "Feriados",
        _ => "Configurações",
    };
}

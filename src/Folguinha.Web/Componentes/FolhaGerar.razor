@inherits PaginaBase
@* Nova escala: período + última folga de quem ainda não tem histórico. *@

<Folha Aberta="Aberta" Titulo="Gerar escala" AoFechar="AoFechar">
    @* o que impede de gerar vem antes de tudo: no celular o rodapé da folha fica fora da tela *@
    @foreach (var p in Pendencias)
    {
        <div class="nota alerta">
            <Icone Nome="alerta" Tamanho="18" />
            <span class="cresce">@p.Texto</span>
            <a class="botao pequeno" href="@p.Link">@p.Acao</a>
        </div>
    }

    @if (FolgasExtras.NaMesmaSemana(Dados) is { Count: > 1 } juntos)
    {
        <div class="nota alerta">
            <Icone Nome="alerta" Tamanho="18" />
            <span class="cresce">
                @juntos.Count pessoas têm a folga extra na mesma semana, então folgam sempre juntas
                e a loja fica vazia nesse fim de semana.
            </span>
            <button type="button" class="botao pequeno" @onclick="RevezarFolgasExtras">Revezar</button>
        </div>
    }

    <fieldset>
        <legend>Período</legend>
        <div class="segmentado" role="group" aria-label="Tipo de período">
            @foreach (var (tipo, rotulo) in Tipos)
            {
                var t = tipo;
                <button type="button" aria-pressed="@((_tipo == t) ? "true" : "false")" @onclick="() => MudarTipo(t)">@rotulo</button>
            }
        </div>
    </fieldset>
    <label class="campo">Começa em <input type="date" value="@_inicio.ToString("yyyy-MM-dd")" @onchange="MudarInicio" /></label>
    <p class="ajuda">De <strong>@Formatos.Dia(_inicio)/@_inicio.Year</strong> a <strong>@Formatos.Dia(Fim)/@Fim.Year</strong> (@(Fim.DayNumber - _inicio.DayNumber + 1) dias)</p>

    @if (Existente is { } e)
    {
        <p class="nota alerta">
            <Icone Nome="info" Tamanho="18" />
            <span>
                @if (e.Encerrada)
                {
                    @($"A escala de {Formatos.Periodo(e)} está encerrada.")
                }
                else if (e.Inicio == _inicio && e.Fim == Fim)
                {
                    @($"Essa escala já existe. Gerar de novo refaz o rascunho mantendo os ajustes manuais.")
                }
                else
                {
                    @($"Já existe a escala de {Formatos.Periodo(e)}, que se sobrepõe a esse período.")
                }
            </span>
        </p>
    }

    @if (SemHistorico.Count > 0)
    {
        <div class="pilha">
            <h3>Última folga antes de @Formatos.Dia(_inicio)</h3>
            <p class="ajuda pequeno">Essas pessoas ainda não têm escala no app. Informe a última folga para a nova escala respeitar os dias já trabalhados.</p>
            @foreach (var f in SemHistorico)
            {
                var pessoa = f;
                <label class="campo">
                    @f.Nome
                    <input type="date" max="@_inicio.AddDays(-1).ToString("yyyy-MM-dd")"
                           value="@(_ultimas.GetValueOrDefault(f.Id)?.ToString("yyyy-MM-dd") ?? f.Situacao?.UltimaFolga.ToString("yyyy-MM-dd"))"
                           @onchange="e => _ultimas[pessoa.Id] = DateOnly.TryParse(e.Value?.ToString(), out var d) ? d : null" />
                </label>
            }
        </div>
    }

    <button type="button" class="botao primario" disabled="@(_gerando || Bloqueado)" @onclick="Gerar">
        <Icone Nome="gerar" Tamanho="20" Traco="2" /> @(_gerando ? "Gerando… pode levar alguns segundos" : "Gerar rascunho")
    </button>
</Folha>

@code {
    [Parameter] public bool Aberta { get; set; }
    [Parameter] public EventCallback AoFechar { get; set; }
    [Parameter] public EventCallback<Escala> AoGerar { get; set; }

    enum TipoPeriodo { Semana, Quinzena, Mes }

    static readonly (TipoPeriodo, string)[] Tipos = [(TipoPeriodo.Semana, "Semana"), (TipoPeriodo.Quinzena, "Quinzena"), (TipoPeriodo.Mes, "Mês")];

    TipoPeriodo _tipo = TipoPeriodo.Mes;
    DateOnly _inicio;
    bool _gerando, _aberta;
    readonly Dictionary<Guid, DateOnly?> _ultimas = [];

    protected override void OnParametersSet()
    {
        if (Aberta && !_aberta) Sugerir();
        _aberta = Aberta;
    }

    void Sugerir()
    {
        var ultima = Dados.Escalas.MaxBy(e => e.Fim);
        if (ultima is null)
        {
            _tipo = TipoPeriodo.Mes;
            _inicio = new DateOnly(Loja.Hoje.Year, Loja.Hoje.Month, 1);
            return;
        }
        var duracao = ultima.Fim.DayNumber - ultima.Inicio.DayNumber + 1;
        _tipo = duracao <= 7 ? TipoPeriodo.Semana : duracao <= 16 ? TipoPeriodo.Quinzena : TipoPeriodo.Mes;
        _inicio = ultima.Fim.AddDays(1);
        Ajustar();
    }

    void MudarTipo(TipoPeriodo t)
    {
        _tipo = t;
        Ajustar();
    }

    void MudarInicio(ChangeEventArgs e)
    {
        if (!DateOnly.TryParse(e.Value?.ToString(), out var d)) return;
        _inicio = d;
        Ajustar();
    }

    /// Alinha o início ao tipo: semana começa na segunda; quinzena no dia 1 ou 16; mês no dia 1.
    void Ajustar() => _inicio = _tipo switch
    {
        TipoPeriodo.Semana => Formatos.Segunda(_inicio),
        TipoPeriodo.Quinzena => new DateOnly(_inicio.Year, _inicio.Month, _inicio.Day < 16 ? 1 : 16),
        _ => new DateOnly(_inicio.Year, _inicio.Month, 1),
    };

    DateOnly Fim => _tipo switch
    {
        TipoPeriodo.Semana => _inicio.AddDays(6),
        TipoPeriodo.Quinzena => _inicio.Day == 1 ? _inicio.AddDays(14) : new DateOnly(_inicio.Year, _inicio.Month, 1).AddMonths(1).AddDays(-1),
        _ => _inicio.AddMonths(1).AddDays(-1),
    };

    Escala? Existente => Dados.Escalas.FirstOrDefault(e => e.Inicio <= Fim && e.Fim >= _inicio);

    /// O botão só desabilita por um motivo que está escrito na tela, com o atalho para resolver.
    bool Bloqueado => Pendencias.Count > 0;

    List<Funcionario> SemHistorico =>
        [.. Dados.Funcionarios.Where(f => !Dados.Escalas.Any(e => e.Inicio < _inicio && e.Atual.Any(a => a.FuncionarioId == f.Id))).OrderBy(f => f.Nome)];

    sealed record Pendencia(string Texto, string Acao, string Link);

    const string Volta = "?volta=escala";

    List<Pendencia> Pendencias => new Pendencia?[]
    {
        Dados.Funcionarios.Count == 0
            ? new("Ninguém na equipe ainda.", "Cadastrar", "equipe/novo?volta=escala") : null,
        Dados.Turnos.Count == 0
            ? new("Nenhum turno cadastrado.", "Cadastrar", $"configuracoes/turnos{Volta}") : null,
        Dados.Demandas.Count == 0
            ? new("Falta dizer quantas pessoas a loja precisa ao mesmo tempo.", "Definir", $"configuracoes/demanda{Volta}") : null,
        Dados.Funcionamento.Count == 0
            ? new("Falta o horário de funcionamento.", "Definir", $"configuracoes/funcionamento{Volta}") : null,
        Existente is { Encerrada: true }
            ? new("A escala desse período está encerrada e não aceita mais mudanças.", "Ver histórico", "historico") : null,
        Existente is { Encerrada: false } x && (x.Inicio != _inicio || x.Fim != Fim)
            ? new($"O período se sobrepõe à escala de {Formatos.Periodo(x)}.", "Abrir", "escala") : null,
    }.OfType<Pendencia>().ToList();

    /// Conserta o cadastro antigo: espalha a folga extra da equipe pelas semanas do ciclo.
    async Task RevezarFolgasExtras()
    {
        if (FolgasExtras.NaMesmaSemana(Dados).FirstOrDefault()?.FolgaExtra is not { } modelo) return;
        await Loja.Alterar(d => FolgasExtras.Revezar(d, modelo),
            $"Folga extra revezada em {modelo.ACadaSemanas} grupos. Gere o rascunho de novo.");
    }

    async Task Gerar()
    {
        _gerando = true;
        StateHasChanged();
        await Respirar();
        try
        {
            var dados = Dados with
            {
                Funcionarios = [.. Dados.Funcionarios.Select(f => _ultimas.GetValueOrDefault(f.Id) is { } u
                    ? f with { Situacao = (f.Situacao ?? new SituacaoInicial(u)) with { UltimaFolga = u } }
                    : f)],
            };
            var (novos, escala, violacoes) = Escalas.Gerar(dados, _inicio, Fim);
            var bloqueios = violacoes.Count(v => v.Severidade == Domain.Regras.Severidade.Bloqueio);
            await Loja.Substituir(novos, bloqueios == 0
                ? "Rascunho gerado. Revise os avisos e publique."
                : $"Rascunho gerado com {Formatos.Plural(bloqueios, "bloqueio", "bloqueios")} para resolver.");
            _ultimas.Clear();
            await AoGerar.InvokeAsync(escala);
        }
        catch (EscalaException e)
        {
            Loja.Avisar(e.Message, erro: true);
        }
        _gerando = false;
    }
}
